# Paramètres de n8n et d'Umami pour Andy Construct : MODÈLE.
# Copier en automation/.env sur le VPS (jamais versionné), puis remplir.
# Générer un secret : openssl rand -hex 32
# Documentation : docs/v2/automatisation.md §4 et §5.

# --- Infrastructure ---------------------------------------------------------
N8N_VERSION=stable                 # fixer la version stable du moment (docs.n8n.io, notes de version)
N8N_DOMAINE=n8n.andyconstruct.ch
UMAMI_DOMAINE=stats.andyconstruct.ch
UMAMI_VERSION=postgresql-latest
POSTGRES_USER=andy
POSTGRES_PASSWORD=                 # À REMPLIR (secret)
N8N_ENCRYPTION_KEY=                # À REMPLIR (secret ; chiffre les identifiants stockés dans n8n)
UMAMI_APP_SECRET=                  # À REMPLIR (secret)

# --- Secrets partagés avec site/api/config.php ------------------------------
AC_HMAC_SECRET=                    # = secrets.hmac_webhook (signature des webhooks du site)
AC_ACTION_SECRET=                  # = secrets.actions (liens en un clic, désinscription)
AC_N8N_URL=https://n8n.andyconstruct.ch   # adresse publique, sans barre finale

# --- Personnes ---------------------------------------------------------------
AC_EMAIL_EXPEDITEUR=site@andyconstruct.ch
AC_EMAILS_ASSOCIES=prenom1@andyconstruct.ch,prenom2@andyconstruct.ch
AC_ASSOCIE_BUREAU_NOM=             # rôles à confirmer par le client
AC_ASSOCIE_BUREAU_EMAIL=
AC_ASSOCIE_BUREAU_MOBILE=          # format +4178…
AC_ASSOCIE_TERRAIN_NOM=
AC_ASSOCIE_TERRAIN_EMAIL=
AC_ASSOCIE_TERRAIN_MOBILE=
AC_AGENCE_EMAIL=                   # alertes, purge, rapport
AC_AGENCE_MOBILE=                  # SMS d'erreur (facultatif)

# --- SMS (ASPSMS, Suisse) ----------------------------------------------------
ASPSMS_USERKEY=                    # À REMPLIR
ASPSMS_PASSWORD=                   # À REMPLIR (mot de passe API)
ASPSMS_ORIGINATOR=AndyConstr       # 11 caractères au plus
AC_SMS_URL=                        # vide = https://json.aspsms.com/SendSimpleTextSMS ; en recette : URL d'un webhook de test

# --- Pipedrive ----------------------------------------------------------------
AC_PD_DOMAINE=andyconstruct        # sous-domaine : https://andyconstruct.pipedrive.com
# Identifiants (pipelines, étapes, utilisateurs, filtres enregistrés), relevés dans Pipedrive :
AC_PD_IDS={"pipeline_demandes":1,"etape_nouvelle":1,"etape_contact":2,"etape_visite":3,"etape_offre":4,"etape_relance":5,"pipeline_chantiers":2,"etape_chantier_termine":9,"pipeline_b2b":3,"etape_b2b_a_contacter":12,"etape_b2b_courrier":13,"etape_b2b_appel":14,"etape_b2b_interesse":15,"etape_b2b_pas_maintenant":17,"etape_b2b_ne_plus":18,"pipeline_ao":4,"etape_ao_etudie":20,"utilisateur_bureau":111,"utilisateur_terrain":112,"filtre_nouvelles":1,"filtre_offres":2,"filtre_perdues":3,"filtre_chantiers_termines":4,"filtre_chantiers_clos":5,"filtre_b2b_a_contacter":6,"filtre_b2b_suivi":7,"filtre_toutes":8}
# Clés API (40 caractères) des champs personnalisés : Paramètres > Champs de données > « … » > clé API.
# Un champ absent de la liste est simplement ignoré.
AC_PD_CHAMPS={"ref_demande":"","canal":"","source":"","source_detail":"","connu_par":"","type_client":"","service":"","surface":"","delai":"","commune":"","zone":"","score":"","priorite":"","sla_echeance":"","relance_sla_niveau":"","date_premier_contact":"","tentatives_appel":"","date_offre":"","num_offre":"","relance_offre_etape":"","a_repondu":"","motif_perte":"","recontact_autorise":"","relance_6m_le":"","date_reception_chantier":"","reserves_levees":"","litige":"","avis_demande_le":"","avis_relance_le":"","avis_recu":"","accord_photos_demande_le":"","accord_publication":"","pieces_ou_service":"","entretien_envoye_le":"","ne_pas_relancer":"","opposition_marketing":"","dernier_message_marketing":"","info_exception_client":"","regie_annuel_le":"","asterisque_verifie":"","palier":"","priorite_b2b":"","ao_en_cours":"","recontact_le":"","suivi_b2b_le":"","etiquette_personne":"","type":""}

# --- Contenus ------------------------------------------------------------------
AC_LIEN_AVIS_GOOGLE=               # lien direct « laisser un avis » de la fiche Google
AC_FICHE_BRUIT=                    # fiche projet citée dans le conseil E2 du guide « bruit » (facultatif)
AC_FICHE_BRUIT_COMMUNE=
AC_FICHE_REGIE=                    # fiche projet « immeuble habité » (facultatif)
AC_JOURS_FERMES=                   # fermetures de l'entreprise, AAAA-MM-JJ séparés par des virgules
AC_B2B_PAR_SEMAINE=5

# --- Supervision, rapport, conformité ------------------------------------------
AC_HEALTHCHECK_HORLOGE=            # https://hc-ping.com/… (contrôle « toutes les 15 min, délai de grâce 30 min »)
AC_CRON_URL=                       # https://www.andyconstruct.ch/api/cron.php?cle=… si l'hébergeur n'a pas de cron
AC_UMAMI_URL=https://stats.andyconstruct.ch
AC_UMAMI_SITE=                     # identifiant du site dans Umami
AC_GOOGLE_PLACE_ID=                # identifiant de la fiche Google (Places API)
AC_SEARCH_CONSOLE_SITE=sc-domain:andyconstruct.ch
AC_PURGE_AUTO=false                # true : effacement automatique des prospects inactifs depuis 24 mois
