        "jsCode": "const e = $('Expéditeur et STOP').item.json;\nconst items = ($input.item.json.data && $input.item.json.data.items) || [];\nreturn { json: { ...e, person_id: items.length ? items[0].item.id : null } };\n",
        "mode": "runOnceForEachItem"
      },
