    {
      "parameters": {
        "jsCode": "// On ne garde que l'adresse de l'expéditeur et un indicateur STOP ; le corps est abandonné ici.\nreturn $input.all().map((i) => {\n  const de = String(i.json.from || '').match(/[^\\s<>\"]+@[^\\s<>\"]+/);\n  const debut = String(i.json.textPlain || i.json.text || '').trim().slice(0, 40);\n  return { json: { email: de ? de[0].toLowerCase() : '', stop: /^stop\\b/i.test(debut) || /^\\s*stop\\s*$/i.test(String(i.json.subject || '')) } };\n}).filter((i) => i.json.email && !/andyconstruct\\.ch$/.test(i.json.email));\n"
      },
      "id": "9675434e-cc27-e576-32c1-ff73c7c8ca53",
      "name": "Expéditeur et STOP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ],
      "notes": "Minimisation : aucune autre donnée du message ne sort de ce nœud.",
      "notesInFlow": false
    },
