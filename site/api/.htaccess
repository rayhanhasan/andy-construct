# Endpoint des formulaires Andy Construct (Apache / LiteSpeed).
# Seuls demande.php, fichier.php et cron.php sont accessibles depuis le web.
# config.php, lib/, data/, modeles/, vendor/, tests/ et stockage/ sont refusés.

Options -Indexes

# 1. Tout est refusé par défaut, sauf les trois points d'entrée.
<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "^(demande|fichier|cron)\.php$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "^(demande|fichier|cron)\.php$">
        Order allow,deny
        Allow from all
    </FilesMatch>
</IfModule>

# 2. Refus explicite des dossiers internes et des fichiers cachés (double protection).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(lib|data|modeles|tests|vendor|stockage)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^config(\.example)?\.php$ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
</IfModule>

# 3. En-têtes de sécurité.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
</IfModule>

# 4. PHP sous mod_php (avec PHP-FPM, ces valeurs sont dans .user.ini).
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
    php_value upload_max_filesize 8M
    php_value post_max_size 26M
    php_value max_file_uploads 5
    php_value memory_limit 192M
</IfModule>
