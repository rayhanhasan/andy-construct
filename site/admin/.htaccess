# Tableau de bord d'administration Andy Construct (Apache / LiteSpeed).
# Seuls index.php et assets/ sont servis. lib/, pages/, outils/ et tests/ sont refusés,
# comme les fichiers cachés et la documentation. Aucune indexation.

Options -Indexes -MultiViews
DirectoryIndex index.php

# 1. Tout fichier PHP est refusé, sauf le point d'entrée.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|inc|md|json|sqlite|db|log|sh|py|bak|dist)$">
        Require all denied
    </FilesMatch>
    <Files "index.php">
        Require all granted
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|inc|md|json|sqlite|db|log|sh|py|bak|dist)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <Files "index.php">
        Order allow,deny
        Allow from all
    </Files>
</IfModule>

# 2. Dossiers internes et fichiers cachés (double protection, en plus de leur propre .htaccess).
<IfModule mod_rewrite.c>
    RewriteEngine On
    # HTTPS obligatoire (le cookie de session est « Secure ») : ce .htaccess remplace les
    # règles de réécriture de la racine, la redirection est donc répétée ici.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    RewriteRule ^(lib|pages|outils|tests)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
</IfModule>

# 3. En-têtes de sécurité (index.php envoie aussi les siens, dont la CSP).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    <FilesMatch "\.(css|js|png)$">
        Header set Cache-Control "private, max-age=86400"
    </FilesMatch>
</IfModule>

# 4. PHP sous mod_php (avec PHP-FPM, ces valeurs sont dans .user.ini).
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
    php_flag session.use_strict_mode on
    php_flag session.use_only_cookies on
    php_flag session.use_trans_sid off
    php_value post_max_size 2M
    php_value upload_max_filesize 1M
</IfModule>
